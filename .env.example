# Upstox API — Sandbox (paper trading) or Live
# Step 1: developer.upstox.com → My Apps → Sandbox tab → Create App
# Step 2: Set redirect URI exactly: http://127.0.0.1:8080/callback
# Step 3: Run: python -m brokers.upstox_broker --login
UPSTOX_API_KEY=2110e364-25ea-4b7c-9406-2f0c1dafa2f4
UPSTOX_API_SECRET=pg1mqyiuw5
UPSTOX_REDIRECT_URI=http://127.0.0.1:8080/callback
UPSTOX_ACCESS_TOKEN=          # filled automatically after --login
UPSTOX_SANDBOX=true           # true = sandbox (paper), false = live (real money)

# Zerodha Kite Connect (optional — ₹2000/month)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Gmail API (for daily email reports)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
REPORT_EMAIL_TO=

# Optional: CoinGecko Pro API key (free tier works without this)
COINGECKO_API_KEY=

# ── Google Sheets paper-trade dashboard ─────────────────────────────────────
# Step 1: console.cloud.google.com → create a Service Account → create a JSON key
# Step 2: Enable "Google Sheets API" and "Google Drive API" for the project
# Step 3: Provide the key below (raw JSON on one line, OR a path to the .json file)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternatively, the standard Google env var pointing at the key file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
# Leave blank to let the bot auto-create the spreadsheet on first run;
# it prints the URL and saves the ID to output/gsheet_id.txt. Paste it here to reuse:
GOOGLE_SHEET_ID=
# Email to share the auto-created sheet with (so you can open/edit it).
# Falls back to REPORT_EMAIL_TO if unset.
GSHEET_SHARE_EMAIL=
